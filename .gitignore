# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Distribution / packaging ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
.pyright/
.ruff_cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── CIA — generated / downloaded assets ───────────────────────────────────────
# ONNX model — 22 MB, downloaded at first run; do not commit
cia/assets/cc_model.onnx
cia/assets/cc_tokenizer.json

# Learned linear head — auto-generated from cc_model.onnx at first load
cia/assets/cc_head.npy

# Compiled ZKP circuit artefacts (generated by compile_circuits.py)
cia/assets/circuits/*/
!cia/assets/circuits/age_gte_18/age_gte_18.circom

# ── CIA — runtime databases ───────────────────────────────────────────────────
# SQLite files written by PDS and AuditLog at runtime
*.db
*.db-wal
*.db-shm

# Simulation JSON exports
report.json
*.report.json

# ── CIA — test artefacts ──────────────────────────────────────────────────────
# Empty assets directory used to force symbolic-only CC mode in tests
# (keep the directory itself but not any stray files dropped into it)
tests/_cc_empty_assets/*
!tests/_cc_empty_assets/.gitkeep

# ── Secrets / credentials ─────────────────────────────────────────────────────
.env
*.pem
*.key
*.secret
secrets.json
